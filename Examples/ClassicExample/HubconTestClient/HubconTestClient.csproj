<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
		<ServerGarbageCollection>false</ServerGarbageCollection>

		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishAot>true</PublishAot>
		<IsAotCompatible>true</IsAotCompatible>
		<TrimMode>link</TrimMode>
		<StackTraceSupport>false</StackTraceSupport>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Hubcon.Analyzers.SourceGenerators" Version="1.0.0-rc*" />
		<PackageReference Include="Hubcon.Analyzers.DiagnosticSuppressors" Version="1.0.0-rc*" />
		<ProjectReference Include="..\..\..\Hubcon.Client\Hubcon.Client.csproj" />
		<ProjectReference Include="..\..\HubconTestDomain\HubconTestDomain.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="runtimeconfig.template.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>