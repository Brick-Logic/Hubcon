<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net5.0;netstandard2.1</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>9.0</LangVersion>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

		<AssemblyName>Hubcon.Client</AssemblyName>
		<RootNamespace>Hubcon.Client</RootNamespace>

		<PackageOutputPath>../nupkgs</PackageOutputPath>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>Hubcon.Client</PackageId>
		<Authors>Brick-Logic</Authors>
		<Company>Brick-Logic</Company>
		<Description>Hubcon's .NET client for consuming remote Hubcon.Server based and standard REST based APIs via C# interfaces, with multi-transport support.</Description>
		<PackageTags>rpc;dotnet;high-performance;native-aot;tcp;http;websockets</PackageTags>
		<RepositoryUrl>https://github.com/Brick-Logic/Hubcon</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryBranch>main</RepositoryBranch>
		<Version>$(HubconClientVersion)</Version>
		<Authors>$(Authors)</Authors>
		<Company>$(Company)</Company>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>embedded</DebugType>
		<Deterministic>True</Deterministic>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>embedded</DebugType>
		<Deterministic>True</Deterministic>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Hubcon.Client.Abstractions\Hubcon.Client.Abstractions.csproj" />
		<ProjectReference Include="..\Hubcon.Client.Core\Hubcon.Client.Core.csproj" />
		<ProjectReference Include="..\Hubcon.Shared.Abstractions.Standard\Hubcon.Shared.Abstractions.Standard.csproj" />
		<ProjectReference Include="..\Hubcon.Shared.Abstractions\Hubcon.Shared.Abstractions.csproj" />
		<ProjectReference Include="..\Hubcon.Shared.Core\Hubcon.Shared.Core.csproj" />
		<ProjectReference Include="..\Hubcon.Shared\Hubcon.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Hubcon.Analyzers" Version="[2.0.0-rc1, 3.0.0)" />
		<PackageReference Include="Hubcon.Analyzers.CodeFixes" Version="[2.0.0-rc1, 3.0.0)"/>
		<PackageReference Include="Hubcon.Analyzers.DiagnosticSuppressors" Version="[2.0.0-rc1, 3.0.0)" />
	</ItemGroup>

	<ItemGroup Condition="$(SuppressHubconGenerators) == DEADCODE">
		<PackageReference Include="Hubcon.Analyzers.SourceGenerators" Version="[2.0.0-rc1, 3.0.0)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\Hubcon.Client.targets" Pack="true" PackagePath="build\" />
	</ItemGroup>
	
	<ItemGroup>
		<None Update="README.md">
			<PackagePath>./</PackagePath>
			<Pack>true</Pack>
		</None>
	</ItemGroup>
</Project>