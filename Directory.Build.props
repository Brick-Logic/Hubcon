<Project>
    <PropertyGroup>
        <!-- Propiedades comunes para todos los proyectos -->
        <Authors>Brick-Logic</Authors>
        <Company>Brick-Logic</Company>
        <Copyright>Copyright © $(Company) $([System.DateTime]::Now.Year)</Copyright>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/Brick-Logic/Hubcon</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
        <Stage>rc</Stage>
        <UsePackages>false</UsePackages>
        
        <HubconUnifiedVersion>2.0.0-rc93</HubconUnifiedVersion>
        
        <!-- Client -->
        <HubconClientVersion>2.0.0-rc93</HubconClientVersion>
        <!-- Client Abstractions -->
        <HubconClientAbstractionsVersion>2.0.0-rc93</HubconClientAbstractionsVersion>
        <!-- Client Core -->
        <HubconClientCoreVersion>2.0.0-rc93</HubconClientCoreVersion>
        
        <!-- Server -->
        <HubconServerVersion>2.0.0-rc93</HubconServerVersion>
        <!-- Server Abstractions -->
        <HubconServerAbstractionsVersion>2.0.0-rc93</HubconServerAbstractionsVersion>
        <!-- Server Core -->
        <HubconServerCoreVersion>2.0.0-rc93</HubconServerCoreVersion>

        <!-- Shared -->
        <HubconSharedVersion>2.0.0-rc93</HubconSharedVersion>
        <!-- Shared Abstractions -->
        <HubconSharedAbstractionsVersion>2.0.0-rc93</HubconSharedAbstractionsVersion>
        <!-- Shared Abstractions Standard -->
        <HubconSharedAbstractionsStandardVersion>2.0.0-rc93</HubconSharedAbstractionsStandardVersion>
        <!-- Shared Core -->
        <HubconSharedCoreVersion>2.0.0-rc93</HubconSharedCoreVersion>
        
        
        <HubconClientRange>[2.0.0-rc1, 3.0.0)</HubconClientRange>
        <HubconServerRange>[2.0.0-rc1, 3.0.0)</HubconServerRange>
        <HubconSharedRange>[2.0.0-rc1, 3.0.0)</HubconSharedRange>
        
        <!-- Analyzer versions -->
        <AnalyzersVersion>2.0.0-rc93</AnalyzersVersion>
        <AnalyzersCodeFixesVersion>2.0.0-rc93</AnalyzersCodeFixesVersion>
        <AnalyzersDiagnosticSuppressorsVersion>2.0.0-rc93</AnalyzersDiagnosticSuppressorsVersion>
        <SourceGeneratorsVersion>2.0.0-rc93</SourceGeneratorsVersion>

        <!-- Analyzer ranges for consuming packages -->
        <AnalyzersRange>[2.0.0-rc1, 3.0.0)</AnalyzersRange>
        <AnalyzersCodeFixesRange>[2.0.0-rc1, 3.0.0)</AnalyzersCodeFixesRange>
        <AnalyzersDiagnosticSuppressorsRange>[2.0.0-rc1, 3.0.0)</AnalyzersDiagnosticSuppressorsRange>
        <SourceGeneratorsRange>[2.0.0-rc1, 3.0.0)</SourceGeneratorsRange>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')"/>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)README.md')"/>
    </ItemGroup>
</Project>