<Project>
    <PropertyGroup>
        <!-- Propiedades comunes para todos los proyectos -->
        <Authors>Brick-Logic</Authors>
        <Company>Brick-Logic</Company>
        <Copyright>Copyright © $(Company) $([System.DateTime]::Now.Year)</Copyright>
        <RepositoryUrl>https://github.com/Brick-Logic/Hubcon</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
        <Stage>rc</Stage>
        <UsePackages>false</UsePackages>
        
        <HubconUnifiedVersion>2.0.0-rc100</HubconUnifiedVersion>
        
        <!-- Client -->
        <HubconClientVersion>2.0.0-rc100</HubconClientVersion>
        <!-- Client Abstractions -->
        <HubconClientAbstractionsVersion>2.0.0-rc100</HubconClientAbstractionsVersion>
        <!-- Client Core -->
        <HubconClientCoreVersion>2.0.0-rc100</HubconClientCoreVersion>
        
        <!-- Server -->
        <HubconServerVersion>2.0.0-rc100</HubconServerVersion>
        <!-- Server Abstractions -->
        <HubconServerAbstractionsVersion>2.0.0-rc100</HubconServerAbstractionsVersion>
        <!-- Server Core -->
        <HubconServerCoreVersion>2.0.0-rc100</HubconServerCoreVersion>

        <!-- Shared -->
        <HubconSharedVersion>2.0.0-rc100</HubconSharedVersion>
        <!-- Shared Abstractions -->
        <HubconSharedAbstractionsVersion>2.0.0-rc100</HubconSharedAbstractionsVersion>
        <!-- Shared Abstractions Standard -->
        <HubconSharedAbstractionsStandardVersion>2.0.0-rc100</HubconSharedAbstractionsStandardVersion>
        <!-- Shared Core -->
        <HubconSharedCoreVersion>2.0.0-rc100</HubconSharedCoreVersion>
        
        
        <HubconClientRange>[2.0.0-rc1, 3.0.0)</HubconClientRange>
        <HubconServerRange>[2.0.0-rc1, 3.0.0)</HubconServerRange>
        <HubconSharedRange>[2.0.0-rc1, 3.0.0)</HubconSharedRange>
        
        <!-- Analyzer versions -->
        <AnalyzersVersion>2.0.0-rc100</AnalyzersVersion>
        <AnalyzersCodeFixesVersion>2.0.0-rc100</AnalyzersCodeFixesVersion>
        <AnalyzersDiagnosticSuppressorsVersion>2.0.0-rc100</AnalyzersDiagnosticSuppressorsVersion>
        <SourceGeneratorsVersion>2.0.0-rc100</SourceGeneratorsVersion>

        <!-- Analyzer ranges for consuming packages -->
        <AnalyzersRange>[2.0.0-rc1, 3.0.0)</AnalyzersRange>
        <AnalyzersCodeFixesRange>[2.0.0-rc1, 3.0.0)</AnalyzersCodeFixesRange>
        <AnalyzersDiagnosticSuppressorsRange>[2.0.0-rc1, 3.0.0)</AnalyzersDiagnosticSuppressorsRange>
        <SourceGeneratorsRange>[2.0.0-rc1, 3.0.0)</SourceGeneratorsRange>
    </PropertyGroup>
</Project>