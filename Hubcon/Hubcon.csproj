<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>

	  <AssemblyName>$(AssemblyName)</AssemblyName>
	  <RootNamespace>$(AssemblyName)</RootNamespace>
	  <PackageId>$(AssemblyName)</PackageId>
	  <PackageOutputPath>../nupkgs</PackageOutputPath>
	  <IsPackable>true</IsPackable>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <Description>Create a C# interface, implement on server, use in client.</Description>
	  <PackageTags>http;websockets;rpc</PackageTags>
	  <Version>2.0.0-rc1</Version>
	  <Authors>$(Authors)</Authors>
	  <Company>$(Company)</Company>
	  <RepositoryUrl>https://github.com/Brick-Logic/Hubcon</RepositoryUrl>
	  
	  <!-- Desactivar generación automática de nuspec -->
	  <GenerateNuspecDependsOn></GenerateNuspecDependsOn>
	  <RepositoryType>git</RepositoryType>
	  <RepositoryBranch>main</RepositoryBranch>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>embedded</DebugType>
		<Deterministic>True</Deterministic>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>embedded</DebugType>
		<Deterministic>True</Deterministic>
	</PropertyGroup>

	<!-- Development -->
	<ItemGroup Condition="'$(UsePackages)' != 'true'">
		<ProjectReference Include="..\Hubcon.Client\Hubcon.Client.csproj" />
		<ProjectReference Include="..\Hubcon.Shared\Hubcon.Shared.csproj" />
	</ItemGroup>

	<!-- Nuget -->
	<ItemGroup Condition="'$(UsePackages)' == 'true'">
		<PackageReference Include="Hubcon.Client" Version="2.0.0-rc1" />
		<PackageReference Include="Hubcon.Shared" Version="2.0.0-rc1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\Hubcon.targets" Pack="true" PackagePath="build\" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Hubcon.Analyzers" Version="2.0.0-rc1" />
		<PackageReference Include="Hubcon.Analyzers.CodeFixes" Version="2.0.0-rc1" />
		<PackageReference Include="Hubcon.Analyzers.DiagnosticSuppressors" Version="2.0.0-rc1" />
		<PackageReference Include="Hubcon.Analyzers.SourceGenerators" Version="2.0.0-rc1" />
	</ItemGroup>

	<ItemGroup>
		<None Update="README.md">
			<PackagePath></PackagePath>
			<Pack>true</Pack>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="build\" />
	</ItemGroup>
</Project>
