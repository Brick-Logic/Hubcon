<Project>
	<ItemGroup Condition="( '$(UsingMicrosoftNETSdkWeb)' == 'true'  and '$(UseHubconServer)' != 'false' ) or ( '$(UsingMicrosoftNETSdkWeb)' != 'true' and '$(UseHubconServer)' == 'true' )">
		<PackageReference Include="Hubcon.Server" Version="[$(HubconServerVersion), 3.0.0)" />
	</ItemGroup>

	<ItemGroup Condition="$(SuppressHubconGenerators) != true">
		<PackageReference Include="Hubcon.Analyzers.SourceGenerators" Version="[$(SourceGeneratorsVersion), 3.0.0)" />
	</ItemGroup>
</Project>